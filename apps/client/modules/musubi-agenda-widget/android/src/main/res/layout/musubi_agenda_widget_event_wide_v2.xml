<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/musubi_widget_event" style="@style/MusubiWidgetEventRow">
  <TextView android:id="@+id/musubi_widget_stripe" android:layout_width="@dimen/musubi_widget_stripe_width" android:layout_height="match_parent" android:layout_marginEnd="@dimen/musubi_widget_content_gap" android:background="@color/musubi_widget_accent" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="@dimen/musubi_widget_time_column_wide_width" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/musubi_widget_content_gap" android:orientation="vertical">
    <TextView android:id="@+id/musubi_widget_time" style="@style/MusubiWidgetTime" />
    <TextView android:id="@+id/musubi_widget_day" style="@style/MusubiWidgetDate" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/musubi_widget_title" style="@style/MusubiWidgetTitle" />
    <TextView android:id="@+id/musubi_widget_meta" style="@style/MusubiWidgetMeta" />
  </LinearLayout>
</LinearLayout>
