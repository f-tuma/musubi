<?xml version="1.0" encoding="utf-8"?>
<!-- v5 gives installed launchers a new hierarchy for the shared widget shell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/musubi_calendar_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/musubi_widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:paddingTop="@dimen/musubi_widget_inset">

