        {
          "initialized": true,
          "settings": {
            "lastSeenProjectNews": "2026-10-02"
          }
        }
      ],
      "exchanges": [
        {
          "kind": "json",
          "body": {
            "schemaVersion": 1,
            "items": [
              {
                "id": "2026-10-01",
                "title": "First update",
                "body": "A concise product update."
              },
              {
                "id": "2026-10-02",
                "title": "Second update",
                "body": "Another update for every server."
              }
            ]
