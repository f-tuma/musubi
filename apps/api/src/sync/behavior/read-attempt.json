    {
      "id": "resume-is-one-shot",
      "title": "A repeated resume cannot renew the idle deadline twice",
      "steps": [
        {
          "command": "pause",
          "id": "quota"
        },
        {
          "command": "advance",
          "durationMs": 120000
        },
        {
          "command": "resume",
          "id": "quota"
        },
        {
          "command": "advance",
          "durationMs": 89999
        },
        {
          "command": "guard"
        },
        {
          "command": "resume",
          "id": "quota"
        },
        {
          "command": "advance",
          "durationMs": 1
        },
        {
          "command": "guard"
        },
        {
          "command": "dispose"
        },
        {
          "command": "advance",
          "durationMs": 180000
        },
        {
          "command": "guard"
        }
      ],
      "expected": {
        "elapsedMs": 390000,
        "completedAtMs": null,
        "pages": 0,
        "databaseProgress": 0,
        "renewals": 10,
        "resumeCalls": 2,
        "signalReason": "idle",
        "guards": [
          "live",
          "idle",
          "finished"
        ],
        "runs": [],
        "callbacksAfterDispose": 0,
        "pendingTimers": 0
      }
    },
    {
      "id": "dispose-closes-work-and-timers",
      "title": "Disposed work rejects guards and callbacks and releases all timers",
      "steps": [
        {
          "command": "start-blocked",
          "id": "pending",
          "kind": "leaf"
        },
        {
          "command": "dispose"
        },
        {
          "command": "immediate-run",
          "id": "closed"
        },
        {
          "command": "progress"
        },
        {
          "command": "advance",
          "durationMs": 360000
        },
        {
          "command": "guard"
        },
        {
          "command": "dispose"
        }
      ],
      "expected": {
        "elapsedMs": 360000,
        "completedAtMs": null,
        "pages": 0,
        "databaseProgress": 0,
        "renewals": 0,
        "resumeCalls": 0,
        "signalReason": "finished",
        "guards": [
          "finished"
        ],
        "runs": [
          {
            "id": "pending",
            "kind": "leaf",
            "outcome": "finished",
            "entered": true
          },
          {
            "id": "closed",
            "kind": "leaf",
            "outcome": "finished",
            "entered": false
          }
