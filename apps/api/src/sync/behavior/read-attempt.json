{
  "schemaVersion": 1,
  "suite": "read-attempt",
  "driver": "read-attempt",
  "scenarios": [
    {
      "id": "steady-large-pagination",
      "title": "190 progressing leaves and DB apply exceed 90 seconds without a total pull cap",
      "steps": [
        {
          "command": "pages",
          "id": "fetch",
          "count": 190,
          "leafMs": 500
        },
        {
          "command": "database-progress",
          "id": "apply",
          "durationMs": 500
        },
        {
          "command": "guard"
        },
        {
          "command": "dispose"
        },
        {
          "command": "advance",
          "durationMs": 180000
        },
        {
          "command": "guard"
        }
      ],
      "expected": {
        "elapsedMs": 275500,
        "completedAtMs": 95500,
        "pages": 190,
        "databaseProgress": 1,
        "renewals": 4,
        "resumeCalls": 0,
        "signalReason": "finished",
        "guards": [
          "live",
          "finished"
        ],
        "runs": [
          {
            "id": "fetch",
            "kind": "pages",
            "outcome": "completed",
            "entered": true
          },
          {
            "id": "apply",
            "kind": "database",
            "outcome": "completed",
            "entered": true
          }
        ],
        "callbacksAfterDispose": 0,
        "pendingTimers": 0
      }
    },
    {
      "id": "quota-pause-keeps-heartbeats",
      "title": "Explicit quota pause outlives the idle interval while renewals continue",
      "steps": [
        {
          "command": "pause",
          "id": "quota"
        },
        {
          "command": "start-blocked",
          "id": "pull",
          "kind": "leaf"
        },
        {
          "command": "advance",
          "durationMs": 120000
        },
        {
          "command": "guard"
        },
        {
          "command": "resume",
          "id": "quota"
        },
        {
          "command": "guard"
        },
        {
          "command": "dispose"
        },
        {
          "command": "advance",
          "durationMs": 180000
        },
        {
          "command": "guard"
        }
      ],
      "expected": {
        "elapsedMs": 300000,
        "completedAtMs": null,
        "pages": 0,
        "databaseProgress": 0,
        "renewals": 6,
        "resumeCalls": 1,
        "signalReason": "finished",
        "guards": [
          "live",
          "live",
          "finished"
        ],
        "runs": [
          {
            "id": "pull",
            "kind": "leaf",
            "outcome": "finished",
            "entered": true
          }
        ],
        "callbacksAfterDispose": 0,
        "pendingTimers": 0
      }
    },
