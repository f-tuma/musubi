{
  "name": "@musubi/web",
  "private": true,
  "description": "Musubi web calendar workspace.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "chromatic": "chromatic --build-script-name storybook:build --only-changed --externals '../../packages/calendar/**' --externals '../../packages/design-system/**' --externals '../../packages/types/**'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "lint": "eslint .storybook src --max-warnings 0",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter-tight": "0.4.2",
    "@expo-google-fonts/noto-serif": "0.4.2",
    "@musubi/calendar": "workspace:*",
    "@musubi/design-system": "workspace:*",
    "@musubi/types": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.32",
    "better-auth": "1.6.23",
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "1.25.0",
    "radix-ui": "1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.0",
    "@shadcn/lint": "0.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.11",
    "agentation": "3.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "nitro": "3.0.260610-beta",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
