# Copy this file to `.env`, then replace every placeholder used by your
# deployment. Keep secrets out of Git and back them up outside the database.

# DB
POSTGRES_USER=musubi
POSTGRES_DB=musubi
# Replace this with a long random password.
POSTGRES_PASSWORD=change_for_random_long_password

# Local API/CLI connection. Docker Compose overrides the host to `db`.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Public API listener. Only published by docker-compose.api.yml; in the full stack
# and on Dokploy the API stays on the internal network behind the proxy.
API_SERVER_PORT=7531
# Optional Core activation. All defaults remain off for existing installations.
# The coordinated 0.2.0 release supports activation with client/peer floors >=0.2.0.
# See docs/releasing.md and docs/releases/core-0.2.0-activation.md before enabling.
EVENT_TIME_EDITS_ENABLED=false
PROVIDER_ORGANIZER_EDITS_ENABLED=false
CALDAV_ORGANIZER_EDITS_ENABLED=false
ICLOUD_ORGANIZER_CREATE_ENABLED=false
PROVIDER_RSVP_EDITS_ENABLED=false
# iCloud personal series content; also requires EVENT_TIME_EDITS_ENABLED.
ICLOUD_PERSONAL_CONTENT_WRITES_ENABLED=false
# Separately gated one-off iCloud attendee replies; requires provider RSVP.
ICLOUD_RSVP_EDITS_ENABLED=false
# Excluded from the selected 0.2.0 activation scope.
PROVIDER_REMINDER_EDITS_ENABLED=false
CALDAV_ALARM_EDITS_ENABLED=false
GOOGLE_AVAILABILITY_ENABLED=false

# Hostname the default full stack serves. Caddy gets HTTPS for a domain; use
# `:80` for plain HTTP on a LAN or behind another proxy. Dokploy sets this
# internally because its UI Domain terminates TLS before the gateway.
PUBLIC_HOST=:80

# Optional landing page on `/`, as a host:port the gateway can reach. Left
# unset, `/` opens the app — the web client redirects it to `/app`.
#MARKETING_UPSTREAM=

# Shared API and web image tag, published on each release. Pin a version so the
# stack only updates when you bump it; `latest` follows the newest release.
MUSUBI_TAG=latest

# Internal Prometheus listener. Docker Compose does not publish this port to the
# host; set 0 to disable metrics entirely.
METRICS_PORT=9464

# Closed set: dev, test, prod. Only dev automatically permits private federation
# and CalDAV targets; production deployments must use prod.
ENVIRONMENT=dev

# Server log verbosity: debug, info, warn, error, or silent. Defaults to info.
# Use debug temporarily when diagnosing provider/calendar synchronization.
LOG_LEVEL=info

# BETTER_AUTH_URL must be ORIGIN ONLY — no "/api" suffix.
# The client (services/api.ts) and Better Auth both append "/api/..." themselves.
# Wrong:   https://musubi.pro/api  → produces /api/api/... → 404
# Right:   https://musubi.pro
BETTER_AUTH_URL=http://localhost:7531
# Generate with: openssl rand -base64 32. Outside dev the API refuses placeholder
# values and secrets shorter than 32 characters. Keep it private and stable —
# changing it logs everyone out and orphans encrypted OAuth tokens.
BETTER_AUTH_SECRET=your_secret_here

# Optional browser QA isolation when other Better Auth apps share localhost.
# Only accepted with ENVIRONMENT=dev. Unset keeps the existing cookie names.
# Use 1–64 letters, digits, underscores, or hyphens; changing it requires a new
# sign-in. Browser QA only: leave unset for native/Expo QA, whose auth client
# expects the default cookie prefix. Never set this in test or production.
# DEV_AUTH_COOKIE_PREFIX=musubi-browser-qa

# Refuse sign-in until the address is confirmed. Needs SMTP below — the API
# refuses to boot with this on and no mail server, because the confirmation
# could never arrive. Turning it on later also affects EXISTING accounts: their
# next sign-in is refused and mails them a link.
REQUIRE_EMAIL_VERIFICATION=false

# Comma-separated emails allowed to write announcements in the web admin panel.
# Empty means this server has no admin and the admin panel stays closed.
ADMIN_EMAILS=

# --- Everything below is OPTIONAL: the API boots without it. ---

# Media storage — leaving S3_BUCKET blank stores files in the persistent local
# Docker volume. Setting it switches new media to a remote S3 bucket; existing
# database avatars move lazily on first read. Compose does not launch an S3
# service. Bucket must stay private. After S3 is enabled, changing/disabling its
# backend is rejected until media is migrated. Credentials may be omitted when
# runtime provides an AWS role.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for remote S3-compatible providers. AWS S3 leaves both unset.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Host-only runs default to ./data/media; Compose overrides this path.
#MEDIA_DIR=./data/media

# SMTP — password-reset and other transactional emails. Port 465 uses implicit
# TLS; every other configured port requires STARTTLS. The API verifies it once
# before listening; restart after changing these values. Leave blank to skip.
SMTP_HOST=smtp.sendlayer.net
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=sender@example.com

# Web Push — lets the server send event reminders to a browser that is closed.
# Without these the API never pushes, and each client keeps ringing on its own
# while it is open. Generate a pair (they identify THIS server to the browser
# vendors' push services, so they are per-install and the private one is secret):
#
#   npx web-push generate-vapid-keys
#
# VAPID_SUBJECT must be a mailto: address or an https URL — push services want
# somewhere to complain to, and reject anything else.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google OAuth — required only for Google sign-in and Google Calendar sync.
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=

# Client-side, baked into the mobile app at BUILD time — the server ignores
# these, so a server self-host can leave them blank. The web id is the idToken
# audience for both platforms; the iOS id is the native Google SDK client and is
# REQUIRED for Google sign-in on iOS (its reversed form becomes the URL scheme).
# Create an "iOS" OAuth client for bundle dev.frgtn.musubi in Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Direct public listing used by the update screen. Supplied values require a
# nonzero App Store id. Production iOS needs this OR a valid TestFlight join URL.
EXPO_PUBLIC_IOS_APP_STORE_URL=
# The production EAS profile supplies the current public iOS beta channel.
EXPO_PUBLIC_IOS_TESTFLIGHT_URL=

# Microsoft OAuth (Entra ID app registration) — required only for Outlook
# calendar sync. Redirect URI on the portal: {BETTER_AUTH_URL}/api/auth/callback/microsoft
# Tenant defaults to "common" (any Microsoft account incl. personal); set a
# tenant id only when restricting to a single organization.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
#MICROSOFT_TENANT_ID=common

# Sign in with Apple, PHONE — set to your app's bundle id (dev.frgtn.musubi).
# Presence flips the "Continue with Apple" button on in the app; the server
# verifies the identity token's audience against the bundle id. No secret needed.
APPLE_CLIENT_ID=

# Apple Developer Team ID (10 chars, Apple Developer → Membership). Enables the
# apple-app-site-association file (served at /.well-known/) so iOS invite links
# open the app directly. Unset → that endpoint 404s (universal links just don't
# engage; the Safari hand-off page still works).
APPLE_TEAM_ID=

# Sign in with Apple, BROWSER — a separate registration from the app's, and all
# three are needed before the web client shows the button:
#   APPLE_SERVICES_ID   the Services ID (Apple Developer → Identifiers → Services
#                       IDs), with your domain and
#                       {BETTER_AUTH_URL}/api/auth/callback/apple as the return URL
#   APPLE_KEY_ID        Key ID of a "Sign in with Apple" key (Identifiers → Keys)
#   APPLE_PRIVATE_KEY   contents of that key's .p8 file. Newlines may be written
#                       as \n so it fits on one line.
# The server signs Apple's short-lived client secret itself from these, so there
# is no six-month token to remember to rotate. APPLE_TEAM_ID above is required too.
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Encrypts stored secrets: CalDAV passwords and federated Musubi member tokens.
# Required before anyone connects a CalDAV account (iCloud/Fastmail/…) or a
# federated connection is stored. Generate with: openssl rand -hex 32
CALDAV_ENC_KEY=

# Federation gateway SSRF guard (ADR-005). The API fetches other Musubi servers
# on the user's behalf, so private/loopback targets are refused in prod. Set to
# true only if you legitimately federate servers on a LAN or the same box —
# it lets any signed-in user aim this server at your internal network.
# In dev, private targets are allowed automatically for the documented
# two-server setup. Test and prod refuse them unless explicitly enabled.
FEDERATION_ALLOW_PRIVATE_HOSTS=

# Minutes between scheduled external-provider syncs
# (Google/Microsoft/CalDAV polling → SSE updates). Defaults to 5; 0 disables.
EXTERNAL_SYNC_INTERVAL_MIN=5
