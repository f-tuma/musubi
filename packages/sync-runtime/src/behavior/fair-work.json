{
  "schemaVersion": 1,
  "driver": "fair-work",
  "scenarios": [
    {
      "id": "due-crosses-during-wake-scan",
      "title": "A queued eligibility crossing during selection retains its automatic wake without an unrelated kick",
      "expected": {
        "clockCrossings": 8,
        "completions": 8,
        "externalKicks": 0,
        "active": 0,
        "pending": 0
      }
    },
    {
      "id": "parked-due-crosses-before-timer",
      "title": "A parked continuation cannot lose its wake when eligibility passes before the timer is armed",
      "expected": {
        "clockCrossings": 8,
        "completions": 8,
        "externalKicks": 0,
        "active": 0,
        "pending": 0
      }
    },
    {
      "id": "async-future-hint-crosses-due",
      "title": "A future host hint that becomes due during an async lookup schedules a wake without spinning on repeated stale hints",
      "expected": {
        "starts": 1,
        "unrelatedKicks": 0,
        "timersForRepeatedPastHint": 0,
        "active": 0
      }
    },
    {
      "id": "due-collision-waits-for-release",
      "title": "Due work blocked by a held resource waits for release without a timer loop",
      "expected": {
        "startsBeforeRelease": 0,
        "timersWhileBlocked": 0,
        "startsAfterRelease": 1,
        "active": 0
      }
    },
    {
      "id": "active-deferral-releases-submitters",
      "title": "Direct submitters receive a running background claim's deferral without waiting until its future due time",
      "expected": {
        "releasedSubmitters": 3,
        "exactDue": true,
        "partialInvalidations": [
          [
            "partial"
          ],
          [
            "partial"
          ]
        ],
        "executions": 2,
        "pending": 0
      }
    },
    {
      "id": "account-a-429-b-ready",
      "title": "Account cooldown releases A while ready B dispatches",
      "expected": {
        "results": [
          "deferred",
          "settled"
        ],
        "methods": [
          "B:GET"
        ],
        "active": 0
      }
    },
    {
      "id": "slow-a-b-progress",
      "title": "B completes while A native HTTP is outstanding",
      "expected": {
        "beforeRelease": [
          "A",
          "B"
        ],
        "maxActive": 2,
        "methods": [
          "B:GET",
          "A:GET"
        ]
      }
    },
    {
      "id": "global-capacity-lanes",
      "title": "One pool rotates lanes and recovery families with bounded pull preference",
      "expected": {
        "starts": [
          "event-1",
          "task-1",
          "event-2",
          "pull-1"
        ],
        "maxActive": 1
      }
    },
    {
      "id": "nested-child-collision",
      "title": "Nested child inherits a live permit and unrelated collisions wait",
      "expected": {
        "childActive": 1,
        "blockedChild": "not-eligible",
        "lateRejected": true,
        "maxActive": 2
      }
    },
    {
      "id": "native-leaf-lifetime",
      "title": "Actual native send is one shot and excludes host persistence time",
      "expected": {
        "sends": 1,
        "metrics": [
          7
        ],
        "twiceRejected": true,
        "lateRejected": true,
        "abortedSends": 0
      }
    },
    {
      "id": "unused-reservation-refund",
      "title": "Cancellation before raw dispatch refunds only unused mutation permission",
      "expected": {
        "sends": 0,
        "refundedCredits": 2,
        "refusalMetrics": 0
      }
    },
    {
      "id": "accepted-readback-persistence-failure",
      "title": "Real Task CREATE retains acceptance after readback cooldown SQL failure",
      "expected": {
        "provider": "accepted",
        "acceptedStatus": 201,
        "writerTaskId": "created",
        "methods": [
          "GET",
          "POST",
          "GET"
        ],
        "statuses": [
          200,
          201,
          429
        ],
        "blocked": true,
        "nextReason": "budget-persistence-pending",
        "flushed": true
      }
    },
    {
      "id": "restart-shared-cooldown",
      "title": "Restart starts empty and hydrates a shared account cooldown",
      "expected": {
        "coldReason": "credit",
        "aReason": "cooldown",
        "bReady": true,
        "tenantScopes": 0
      }
    },
    {
      "id": "parked-pages-b-progress",
      "title": "A native pagination continuation exceeds burst while B completes",
      "expected": {
        "pages": 6,
        "bBeforeA": true,
        "maxActive": 2
      }
    },
    {
      "id": "park-until-auxiliary-cold-chain",
      "title": "Four parents and four cold auxiliary refreshes reacquire without deadlock",
      "expected": {
        "sends": 12,
        "refreshCalls": 4,
        "maxActive": 4,
        "maxLogical": 8
      }
    },
    {
      "id": "finite-boundary-cooldown-clocks",
      "title": "Finite boundary cooldowns cap control eligibility and still expire independently",
      "expected": {
        "refusals": 12,
        "capped": 6,
        "finiteExpired": 4,
        "aSends": 4,
        "bSends": 12,
        "metrics": 16
      }
    },
    {
      "id": "max-cooldown-fractional-clocks",
      "title": "MAX account holds preserve exact eligibility across fractional and stepped clocks",
      "expected": {
        "refusals": 8,
        "exactDue": true,
        "sends": 8,
        "metrics": 8
      }
    },
    {
      "id": "long-cooldown-releases-continuations",
      "title": "Four long account cooldowns release continuations before healthy B runs",
      "expected": {
        "results": [
          "deferred",
          "deferred",
          "deferred",
          "deferred",
          "settled"
        ],
        "exactDue": true,
        "methods": [
          "healthy:GET"
        ],
        "parks": 0,
        "logicalActive": 0
      }
    },
    {
      "id": "invalid-retry-after-b-progress",
      "title": "Malformed Retry-After preserves actual429 without poisoning healthy B",
      "expected": {
        "statuses": [
          429,
          200
        ],
        "writes": 0,
        "blocked": false,
        "parsed": "invalid"
      }
    }
  ]
}
