{
  "schemaVersion": 1,
  "driver": "fair-work",
  "scenarios": [
    {
      "id": "due-crosses-during-wake-scan",
      "title": "A queued eligibility crossing during selection retains its automatic wake without an unrelated kick",
      "expected": {
        "clockCrossings": 8,
        "completions": 8,
        "externalKicks": 0,
        "active": 0,
        "pending": 0
      }
    },
    {
      "id": "parked-due-crosses-before-timer",
      "title": "A parked continuation cannot lose its wake when eligibility passes before the timer is armed",
      "expected": {
        "clockCrossings": 8,
        "completions": 8,
        "externalKicks": 0,
        "active": 0,
        "pending": 0
      }
    },
    {
      "id": "async-future-hint-crosses-due",
      "title": "A future host hint that becomes due during an async lookup schedules a wake without spinning on repeated stale hints",
      "expected": {
        "starts": 1,
        "unrelatedKicks": 0,
        "timersForRepeatedPastHint": 0,
        "active": 0
      }
    },
    {
      "id": "due-collision-waits-for-release",
      "title": "Due work blocked by a held resource waits for release without a timer loop",
      "expected": {
        "startsBeforeRelease": 0,
        "timersWhileBlocked": 0,
        "startsAfterRelease": 1,
        "active": 0
      }
    },
    {
      "id": "active-deferral-releases-submitters",
      "title": "Direct submitters receive a running background claim's deferral without waiting until its future due time",
      "expected": {
        "releasedSubmitters": 3,
        "exactDue": true,
        "partialInvalidations": [
          [
            "partial"
          ],
          [
            "partial"
          ]
        ],
        "executions": 2,
        "pending": 0
      }
    },
    {
      "id": "account-a-429-b-ready",
      "title": "Account cooldown releases A while ready B dispatches",
      "expected": {
        "results": [
          "deferred",
          "settled"
        ],
        "methods": [
          "B:GET"
        ],
        "active": 0
      }
    },
    {
      "id": "slow-a-b-progress",
      "title": "B completes while A native HTTP is outstanding",
      "expected": {
        "beforeRelease": [
          "A",
          "B"
        ],
        "maxActive": 2,
        "methods": [
          "B:GET",
          "A:GET"
        ]
      }
    },
    {
      "id": "global-capacity-lanes",
      "title": "One pool rotates lanes and recovery families with bounded pull preference",
      "expected": {
        "starts": [
          "event-1",
          "task-1",
          "event-2",
          "pull-1"
        ],
        "maxActive": 1
      }
    },
    {
      "id": "nested-child-collision",
      "title": "Nested child inherits a live permit and unrelated collisions wait",
      "expected": {
        "childActive": 1,
        "blockedChild": "not-eligible",
        "lateRejected": true,
        "maxActive": 2
      }
    },
    {
      "id": "native-leaf-lifetime",
      "title": "Actual native send is one shot and excludes host persistence time",
      "expected": {
        "sends": 1,
        "metrics": [
          7
        ],
        "twiceRejected": true,
        "lateRejected": true,
        "abortedSends": 0
      }
    },
    {
      "id": "unused-reservation-refund",
      "title": "Cancellation before raw dispatch refunds only unused mutation permission",
      "expected": {
        "sends": 0,
        "refundedCredits": 2,
        "refusalMetrics": 0
      }
    },
    {
      "id": "accepted-readback-persistence-failure",
      "title": "Real Task CREATE retains acceptance after readback cooldown SQL failure",
      "expected": {
        "provider": "accepted",
        "acceptedStatus": 201,
        "writerTaskId": "created",
        "methods": [
          "GET",
          "POST",
          "GET"
        ],
        "statuses": [
          200,
          201,
          429
        ],
        "blocked": true,
        "nextReason": "budget-persistence-pending",
        "flushed": true
      }
    },
    {
      "id": "restart-shared-cooldown",
      "title": "Restart starts empty and hydrates a shared account cooldown",
      "expected": {
        "coldReason": "credit",
        "aReason": "cooldown",
        "bReady": true,
        "tenantScopes": 0
      }
    },
    {
      "id": "parked-pages-b-progress",
      "title": "A native pagination continuation exceeds burst while B completes",
      "expected": {
        "pages": 6,
        "bBeforeA": true,
        "maxActive": 2
      }
    },
    {
      "id": "park-until-auxiliary-cold-chain",
      "title": "Four parents and four cold auxiliary refreshes reacquire without deadlock",
      "expected": {
        "sends": 12,
        "refreshCalls": 4,
        "maxActive": 4,
        "maxLogical": 8
      }
    },
    {
      "id": "shared-permit-abort-fallback",
      "title": "Handled active HTTP cancellation rejects old siblings and preserves a fresh fallback after native settlement",
      "expected": {
        "siblings": 0,
        "fallbacks": 1,
        "fallbackBeforeSettlement": false,
        "logicalActive": 0
      }
    },
    {
      "id": "shared-permit-parallel-http",
      "title": "Concurrent SDK HTTP leaves queue under one permit and resume fairly beyond a cold burst",
      "expected": {
        "statuses": [
          207,
          207
        ],
        "sends": 2,
        "parks": 2,
        "maxRaw": 1,
        "bBeforeA": true,
        "logicalActive": 0
      }
    },
    {
      "id": "shared-permit-inflight-collision",
      "title": "A queued SDK sibling cannot release collision holds while another raw HTTP leaf is in flight",
      "expected": {
        "bBeforeFirstRelease": false,
        "heldWhileRaw": 1,
        "bBeforeSecond": true,
        "bWhileRaw": false,
        "sends": 2,
        "parks": 1,
        "maxRaw": 1,
        "logicalActive": 0
      }
    },
    {
      "id": "finite-boundary-cooldown-clocks",
      "title": "Finite boundary cooldowns cap control eligibility and still expire independently",
      "expected": {
        "refusals": 12,
        "capped": 6,
        "finiteExpired": 4,
        "aSends": 4,
        "bSends": 12,
        "metrics": 16
      }
    },
    {
      "id": "max-cooldown-fractional-clocks",
      "title": "MAX account holds preserve exact eligibility across fractional and stepped clocks",
      "expected": {
        "refusals": 8,
        "exactDue": true,
        "sends": 8,
        "metrics": 8
      }
    },
    {
      "id": "long-cooldown-releases-continuations",
      "title": "Four long account cooldowns release continuations before healthy B runs",
      "expected": {
        "results": [
          "deferred",
          "deferred",
          "deferred",
          "deferred",
          "settled"
        ],
        "exactDue": true,
        "methods": [
          "healthy:GET"
        ],
        "parks": 0,
        "logicalActive": 0
      }
    },
    {
      "id": "invalid-retry-after-b-progress",
      "title": "Malformed Retry-After preserves actual429 without poisoning healthy B",
      "expected": {
        "statuses": [
          429,
          200
        ],
        "writes": 0,
        "blocked": false,
        "parsed": "invalid"
      }
    },
    {
      "id": "parked-pull-request-preflight",
      "title": "A request progresses while its same-account background pull is parked",
      "expected": {
        "foregroundBeforeReadRelease": true,
        "otherAccountCompleted": true,
        "queuedBackgroundStarted": 0,
        "rejection": null
      }
    },
    {
      "id": "parked-pull-durable-delivery",
      "title": "Durable delivery progresses while its same-account background pull is parked",
      "expected": {
        "foregroundBeforeReadRelease": true,
        "otherAccountCompleted": true,
        "queuedBackgroundStarted": 0,
        "rejection": null
      }
    },
    {
      "id": "full-account-pull-queue-request",
      "title": "A full background account queue retains one bounded foreground admission",
      "expected": {
        "foregroundBeforeReadRelease": true,
        "otherAccountCompleted": true,
        "queuedBackgroundStarted": 0,
        "rejection": null
      }
    },
    {
      "id": "parked-foreground-serial",
      "title": "One foreground operation per account retains its turn while parked",
      "expected": {
        "secondBeforeFirstRelease": false,
        "otherAccountCompleted": true,
        "secondAfterFirstRelease": true,
        "maxForegroundLogical": 1
      }
    },
    {
      "id": "four-held-other-accounts-request",
      "title": "A foreground request is admitted while four other-account pulls are offered and held",
      "expected": {
        "withReserve": {
          "backgroundStarted": 3,
          "fourthBackgroundPending": true,
          "startedWhileSaturated": true,
          "rejection": null,
          "maxHeld": 4,
          "maxRegularLogical": 4
        },
        "withoutReserve": {
          "backgroundStarted": 4,
          "startedWhileSaturated": false,
          "rejection": null,
          "admittedAfterOneRelease": true,
          "maxHeld": 4,
          "maxRegularLogical": 4
        }
      }
    },
    {
      "id": "four-held-other-accounts-durable-delivery",
      "title": "Durable event delivery is admitted while four other-account pulls are offered and held",
      "expected": {
        "withReserve": {
          "backgroundStarted": 3,
          "fourthBackgroundPending": true,
          "startedWhileSaturated": true,
          "rejection": null,
          "maxHeld": 4,
          "maxRegularLogical": 4
        },
        "withoutReserve": {
          "backgroundStarted": 4,
          "startedWhileSaturated": false,
          "rejection": null,
          "admittedAfterOneRelease": true,
          "maxHeld": 4,
          "maxRegularLogical": 4
        }
      }
    },
    {
      "id": "four-parked-other-accounts-request",
      "title": "A foreground request is admitted instead of swept while other-account pulls are all parked",
      "expected": {
        "withReserve": {
          "backgroundStarted": 3,
          "parkedBackground": 3,
          "foregroundStarted": true,
          "rejection": null
        },
        "withoutReserve": {
          "backgroundStarted": 4,
          "parkedBackground": 4,
          "foregroundStarted": false,
          "rejection": "work-capacity"
        }
      }
    },
    {
      "id": "reserve-blocks-fourth-background-until-background-release",
      "title": "The reserved slot never admits a fourth background pull; a background release does",
      "expected": {
        "foregroundStartedWhileSaturated": true,
        "fourthPendingAfterForegroundRelease": true,
        "fourthStartedAfterBackgroundRelease": true,
        "maxBackgroundLogical": 3,
        "maxHeld": 4,
        "maxRegularLogical": 4
      }
    },
    {
      "id": "reserve-same-account-held-pull-still-waits",
      "title": "A held same-account pull still serializes the account's foreground request (known limitation)",
      "expected": {
        "withReserve": {
          "foregroundBeforeOwnPullRelease": false,
          "foregroundAfterOwnPullRelease": true,
          "rejection": null,
          "spareRegularWhileWaiting": 3
        },
        "withoutReserve": {
          "foregroundBeforeOwnPullRelease": false,
          "foregroundAfterOwnPullRelease": true,
          "rejection": null,
          "spareRegularWhileWaiting": 3
        }
      }
    },
    {
      "id": "reserve-auxiliary-under-full-regular",
      "title": "An auxiliary refresh is admitted under four regular permits; further pull and foreground wait",
      "expected": {
        "auxiliaryStartedUnderFullRegular": true,
        "regularLogicalAtAuxiliaryStart": 4,
        "furtherPullStartedBeforeRelease": false,
        "furtherForegroundStartedBeforeRelease": false,
        "maxHeld": 4,
        "completed": true
      }
    },
    {
      "id": "reserve-foreground-deadline-cancel",
      "title": "With the reserve a foreground request starts before its deadline; without it the cancelled request never executes",
      "expected": {
        "withReserve": {
          "startedBeforeDeadline": true,
          "executions": 1
        },
        "withoutReserve": {
          "startedBeforeDeadline": false,
          "rejection": "Delivery attempt timeout.",
          "executionsAfterCancel": 0
        }
      }
    },
    {
      "id": "reserve-all-parked-with-foreground",
      "title": "Three parked pulls plus one parked foreground still sweep a further foreground (accepted bounded edge)",
      "expected": {
        "parkedRegular": 4,
        "heldRegular": 0,
        "rejection": "work-capacity",
        "retryDelayMs": 1000
      }
    }
  ]
}
