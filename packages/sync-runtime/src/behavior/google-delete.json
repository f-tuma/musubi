{
  "schemaVersion": 1,
  "scenarios": [
    {
      "id": "conditional-delete",
      "title": "A matching strong ETag permits exactly one conditional DELETE",
      "policy": "musubi",
      "exchanges": [
        {
          "method": "GET",
          "path": "/calendar/v3/calendars/native%2Fcalendar/events/native%2Fevent",
          "status": 200,
          "body": {
            "id": "native/event",
            "etag": "\"before\"",
            "status": "confirmed",
            "eventType": "default",
            "summary": "Synthetic event",
            "start": {
              "dateTime": "2026-10-13T08:00:00Z"
            },
            "end": {
              "dateTime": "2026-10-13T09:00:00Z"
            },
            "organizer": {
              "self": true,
              "email": "owner@example.invalid"
            }
          }
        },
        {
          "method": "GET",
          "path": "/calendar/v3/users/me/calendarList/native%2Fcalendar",
          "status": 200,
          "body": {
            "id": "native/calendar",
            "accessRole": "writer"
          }
        },
        {
          "method": "GET",
          "path": "/calendar/v3/calendars/native%2Fcalendar/events/native%2Fevent",
          "status": 200,
          "body": {
            "id": "native/event",
            "etag": "\"before\"",
            "status": "confirmed",
            "eventType": "default",
            "summary": "Synthetic event",
            "start": {
              "dateTime": "2026-10-13T08:00:00Z"
            },
            "end": {
              "dateTime": "2026-10-13T09:00:00Z"
            },
            "organizer": {
              "self": true,
              "email": "owner@example.invalid"
            }
          }
        },
        {
          "method": "DELETE",
          "path": "/calendar/v3/calendars/native%2Fcalendar/events/native%2Fevent",
          "status": 204,
          "body": null
        }
      ],
      "expected": {
        "status": "acked",
        "methods": [
          "GET",
          "GET",
          "GET",
          "DELETE"
        ],
        "ifMatch": [
          null,
          null,
          null,
          "\"before\""
        ],
        "ackKinds": [
          "provider-response"
        ],
        "finishStatuses": [],
        "provider": {
          "kind": "accepted",
          "status": 204,
