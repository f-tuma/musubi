    {
      "id": "organizer-dispatch-minute-utc",
      "title": "Organizer dispatch and cancellation stamps retain minute precision",
      "boundary": "organizer-dispatch",
      "input": {
        "kind": "google-organizer-dispatch",
        "version": 1,
        "startedAt": "2026-10-27T09:30Z",
        "acceptedAt": "2026-10-27T10:30Z",
        "cancellationTombstone": {
          "revision": 1,
          "deletedAt": "2026-10-27T10:30Z"
        }
      },
      "expectedSuccess": true
    },
    {
      "id": "organizer-dispatch-refuses-offset",
      "title": "UTC-only persisted dispatch stamps still refuse offsets",
      "boundary": "organizer-dispatch",
      "input": {
        "kind": "google-organizer-dispatch",
        "version": 1,
        "startedAt": "2026-10-27T09:30+02:00",
        "acceptedAt": "2026-10-27T10:30Z",
        "cancellationTombstone": {
          "revision": 1,
          "deletedAt": "2026-10-27T10:30Z"
        }
      },
      "expectedSuccess": false
    },
    {
      "id": "organizer-tombstone-invalid-revision",
      "title": "Cancellation tombstones still require a positive revision",
      "boundary": "organizer-dispatch",
      "input": {
        "kind": "google-organizer-dispatch",
        "version": 1,
        "startedAt": "2026-10-27T09:30Z",
        "acceptedAt": "2026-10-27T10:30Z",
        "cancellationTombstone": {
          "revision": 0,
          "deletedAt": "2026-10-27T10:30Z"
        }
      },
      "expectedSuccess": false
    },
