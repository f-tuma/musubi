{
  "schemaVersion": 1,
  "suite": "wire-timestamps",
  "scenarios": [
    {
      "id": "availability-minute-utc",
      "title": "Availability requests accept legacy minute precision in UTC",
      "boundary": "availability-request",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-10-27T10:30Z",
        "sourceIds": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "expectedSuccess": true
    },
    {
      "id": "availability-minute-offset",
      "title": "Availability requests accept legacy minute precision with an offset",
      "boundary": "availability-request",
      "input": {
        "start": "2026-10-27T09:30+02:00",
        "end": "2026-10-27T10:30+02:00",
        "sourceIds": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "expectedSuccess": true
    },
    {
      "id": "availability-interval-minute-utc",
      "title": "Busy intervals preserve minute UTC timestamps",
      "boundary": "availability-interval",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-10-27T10:30Z"
      },
      "expectedSuccess": true
    },
    {
      "id": "availability-interval-minute-offset",
      "title": "Busy intervals preserve minute offset timestamps",
      "boundary": "availability-interval",
      "input": {
        "start": "2026-10-27T09:30+02:00",
        "end": "2026-10-27T10:30+02:00"
      },
      "expectedSuccess": true
    },
    {
      "id": "availability-response-minute-utc",
      "title": "Availability responses preserve UTC minute precision and generation zero",
      "boundary": "availability-response",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-10-27T10:30Z",
        "observedAt": "2026-10-27T09:30Z",
        "sources": [
          {
            "sourceId": "00000000-0000-4000-8000-000000000001",
            "generation": 0,
            "status": "available",
            "intervals": [
              {
                "start": "2026-10-27T09:30Z",
                "end": "2026-10-27T10:30Z"
              }
            ]
          }
        ]
      },
      "expectedSuccess": true
    },
    {
      "id": "availability-response-minute-offset",
      "title": "Availability responses preserve offset minute precision",
      "boundary": "availability-response",
      "input": {
        "start": "2026-10-27T09:30+02:00",
        "end": "2026-10-27T10:30+02:00",
        "observedAt": "2026-10-27T09:30+02:00",
        "sources": [
          {
            "sourceId": "00000000-0000-4000-8000-000000000001",
            "generation": 0,
            "status": "available",
            "intervals": [
              {
                "start": "2026-10-27T09:30+02:00",
                "end": "2026-10-27T10:30+02:00"
              }
            ]
          }
        ]
      },
      "expectedSuccess": true
    },
    {
      "id": "availability-42-days",
      "title": "A range of exactly 42 days remains accepted",
      "boundary": "availability-request",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-12-08T09:30Z",
        "sourceIds": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "expectedSuccess": true
    },
    {
      "id": "availability-over-42-days",
      "title": "A range exceeding 42 days remains refused",
      "boundary": "availability-request",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-12-08T09:31Z",
        "sourceIds": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "expectedSuccess": false
    },
    {
      "id": "availability-equal-bounds",
      "title": "A zero-duration request remains refused",
      "boundary": "availability-request",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-10-27T09:30Z",
        "sourceIds": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "expectedSuccess": false
    },
    {
      "id": "availability-reversed-offset-bounds",
      "title": "Ordering compares instants across offsets",
      "boundary": "availability-request",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-10-27T10:30+02:00",
        "sourceIds": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "expectedSuccess": false
    },
    {
      "id": "availability-interval-reversed",
