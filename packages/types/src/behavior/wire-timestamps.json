      "boundary": "availability-interval",
      "input": {
        "start": "2026-10-27T10:30Z",
        "end": "2026-10-27T09:30Z"
      },
      "expectedSuccess": false
    },
    {
      "id": "availability-interval-empty",
      "title": "Busy intervals with no duration remain refused",
      "boundary": "availability-interval",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-10-27T09:30Z"
      },
      "expectedSuccess": false
    },
    {
      "id": "availability-response-invalid-interval",
      "title": "Response validation still refuses reversed provider intervals",
      "boundary": "availability-response",
      "input": {
        "start": "2026-10-27T09:30Z",
        "end": "2026-10-27T10:30Z",
        "observedAt": "2026-10-27T09:30Z",
        "sources": [
          {
            "sourceId": "00000000-0000-4000-8000-000000000001",
            "generation": 0,
            "status": "available",
            "intervals": [
              {
                "start": "2026-10-27T10:30Z",
                "end": "2026-10-27T09:30Z"
              }
            ]
          }
        ]
      },
      "expectedSuccess": false
    },
    {
      "id": "availability-response-negative-generation",
