    {
      "id": "graph-dispatch-minute-utc",
      "title": "Persisted Graph dispatch timestamps retain minute precision",
      "boundary": "graph-rsvp-dispatch",
      "input": {
        "kind": "graph-rsvp-dispatch",
        "version": 1,
        "startedAt": "2026-10-27T09:30Z",
        "acceptedAt": "2026-10-27T10:30Z"
      },
      "expectedSuccess": true
    },
    {
      "id": "caldav-delivery-minute-utc",
      "title": "Persisted CalDAV delivery timestamps retain minute precision",
      "boundary": "caldav-rsvp-delivery",
      "input": {
        "kind": "caldav-rsvp-at-most-once",
        "version": 1,
