      "targets": [
        {
          "refId": "A",
          "expr": "sum by (priority) (musubi_tasks{job=\"musubi-api\"})",
          "legendFormat": "{{priority}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
