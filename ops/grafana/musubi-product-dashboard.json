    {
      "id": 8,
      "type": "timeseries",
      "title": "Tasks by priority",
      "description": "RFC priority: high 1\u20134, medium 5, low 6\u20139, none 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
