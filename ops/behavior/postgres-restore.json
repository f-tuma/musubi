    {
      "id": "readiness-retry",
      "title": "A transient TCP readiness failure can recover before restoring",
      "input": "custom",
      "ports": [
        {
          "command": "create"
        },
        {
          "command": "start"
        },
        {
          "command": "ready",
          "exitCode": 1
        },
        {
          "command": "ready"
        },
        {
          "command": "restore"
        },
        {
          "command": "tables"
        },
        {
          "command": "stop"
        },
        {
          "command": "remove"
        }
      ],
      "expected": {
        "exitCode": 0,
        "stdoutIncludes": [
          "Restore completed",
          "comparison remains required"
        ],
        "stderrIncludes": []
      }
    },
