    {
      "id": "counts-match",
      "title": "Restore preservation output must exactly match the captured source baseline",
      "input": "custom",
      "ports": [
        {
          "command": "create"
        },
        {
          "command": "start"
        },
        {
          "command": "ready"
        },
        {
          "command": "restore"
        },
        {
          "command": "tables"
        },
        {
          "command": "counts",
          "stdout": "preserved\n7\n"
        },
        {
          "command": "stop"
        },
        {
          "command": "remove"
        }
      ],
      "expected": {
        "exitCode": 0,
        "stdoutIncludes": [
          "matches the supplied baseline",
          "Restore completed"
        ],
        "stderrIncludes": []
      },
      "counts": {
        "expected": "preserved\n7\n",
        "output": "preserved\n7\n"
      }
    },
