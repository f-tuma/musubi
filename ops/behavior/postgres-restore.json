{
  "schemaVersion": 1,
  "suite": "postgres-restore",
  "driver": "postgres-restore",
  "scenarios": [
    {
      "id": "create-failure",
      "title": "Failed or colliding creation never removes an unowned container",
      "input": "custom",
      "ports": [
        {
          "command": "create",
          "exitCode": 1,
          "stderr": "Synthetic creation collision."
        }
      ],
      "expected": {
        "exitCode": 1,
        "stdoutIncludes": [],
        "stderrIncludes": [
          "Synthetic creation collision."
        ]
      }
    },
    {
      "id": "uncertain-create",
      "title": "An unsuccessful create response never authorizes ID or name cleanup",
      "input": "custom",
      "ports": [
        {
          "command": "create",
          "exitCode": 1,
          "stdout": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n"
        }
      ],
      "expected": {
        "exitCode": 1,
        "stdoutIncludes": [],
        "stderrIncludes": []
      }
    },
    {
      "id": "malformed-create-id",
      "title": "Malformed create output never becomes a cleanup target",
      "input": "custom",
      "ports": [
        {
          "command": "create",
          "stdout": "some-existing-container\n"
        }
      ],
      "expected": {
        "exitCode": 1,
        "stdoutIncludes": [],
        "stderrIncludes": [
          "valid full container ID"
        ]
      }
    },
    {
      "id": "short-create-id",
      "title": "A short container ID is rejected without cleanup",
      "input": "custom",
      "ports": [
        {
          "command": "create",
          "stdout": "aaaaaaaaaaaa\n"
        }
      ],
      "expected": {
        "exitCode": 1,
        "stdoutIncludes": [],
        "stderrIncludes": [
          "valid full container ID"
        ]
      }
    },
    {
      "id": "start-failure",
